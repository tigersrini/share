# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local sqlite database
/prisma/*.db
/prisma/*.db-journal

# ad-hoc test scripts written by QA/dev sessions, not part of the app
/scratch-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
